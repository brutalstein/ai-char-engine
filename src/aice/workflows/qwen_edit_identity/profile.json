{
  "name": "qwen_edit_identity",
  "version": "1.0.0",
  "description": "Qwen-Image-Edit-2509 (Nunchaku) identity-into-scene. Empty-latent path: scene from the prompt, identity from 1-3 reference images via TextEncodeQwenImageEditPlus.",
  "required_class_types": [
    "NunchakuQwenImageDiTLoader", "CLIPLoader", "VAELoader", "ModelSamplingAuraFlow",
    "CFGNorm", "TextEncodeQwenImageEditPlus", "EmptySD3LatentImage", "KSampler",
    "VAEDecode", "SaveImage", "LoadImage", "ImageScaleToTotalPixels"
  ],
  "slots": {
    "model_path":     {"node": "115", "input": "model_path"},
    "positive_prompt":{"node": "111", "input": "prompt"},
    "negative_prompt":{"node": "110", "input": "prompt"},
    "width":          {"node": "112", "input": "width"},
    "height":         {"node": "112", "input": "height"},
    "seed":           {"node": "3",   "input": "seed"},
    "steps":          {"node": "3",   "input": "steps"},
    "cfg":            {"node": "3",   "input": "cfg"},
    "sampler":        {"node": "3",   "input": "sampler_name"},
    "scheduler":      {"node": "3",   "input": "scheduler"},
    "output_prefix":  {"node": "60",  "input": "filename_prefix"}
  },
  "reference_slots": [
    {"load": "78",  "scale": "79",  "enc_input": "image1"},
    {"load": "106", "scale": "107", "enc_input": "image2"},
    {"load": "108", "scale": "109", "enc_input": "image3"}
  ],
  "text_encoder_nodes": ["110", "111"],
  "loader_overridable": {
    "note": "NunchakuQwenImageDiTLoader input names are reconciled against live /object_info during `aice comfy setup`; the smoke step rewrites this asset with the exact keys if they differ.",
    "cpu_offload_input": "cpu_offload",
    "blocks_on_gpu_input": "num_blocks_on_gpu"
  }
}
