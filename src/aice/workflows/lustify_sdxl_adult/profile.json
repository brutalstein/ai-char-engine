{
  "name": "lustify_sdxl_adult",
  "version": "1.0.0",
  "description": "LUSTIFY! SDXL v4 uncensored adult photoreal. Scene from the prompt; identity from 1-2 trusted AICE references via IP-Adapter Plus (ViT-H). DPM++ 2M / Karras, 30 steps, CFG 5, batch 1, SDXL ~1 MP buckets.",
  "requires_references": true,
  "adult_explicit": true,
